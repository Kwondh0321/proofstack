{
  "name": "@proofstack/web",
  "version": "0.0.0",
  "private": true,
  "description": "ProofStack operator console",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "next build",
    "clean": "rm -rf .next coverage",
    "dev": "next dev --port 3000",
    "lint": "biome lint app components lib",
    "start": "next start --port 3000",
    "test": "vitest run --coverage",
    "typecheck": "node ../../scripts/prepare-web-typecheck.mjs && next typegen && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@proofstack/contracts": "workspace:*",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitest/coverage-v8": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
