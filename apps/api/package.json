{
  "name": "@proofstack/api",
  "version": "0.0.0",
  "private": true,
  "description": "ProofStack control-plane and development ingestion API",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf coverage dist",
    "dev": "tsx watch src/server.ts",
    "lint": "biome lint src",
    "start": "node dist/server.js",
    "test": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.1",
    "@fastify/rate-limit": "11.2.0",
    "@proofstack/contracts": "workspace:*",
    "@proofstack/core": "workspace:*",
    "@proofstack/identity": "workspace:*",
    "@proofstack/otlp": "workspace:*",
    "@proofstack/postgres": "workspace:*",
    "fastify": "5.12.1",
    "openid-client": "6.8.7",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "0.221.0",
    "@opentelemetry/exporter-trace-otlp-proto": "0.221.0",
    "@opentelemetry/sdk-trace-node": "2.10.0",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "tsx": "4.23.12",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
