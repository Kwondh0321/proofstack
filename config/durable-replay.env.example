# Local-only additive profile for the durable replay example. Source after .env; never deploy it.
PROOFSTACK_REPLAY_WORKER_DATABASE_URL=postgresql://proofstack_replay_worker:proofstack-local-replay-worker@127.0.0.1:5432/proofstack

# Experimental local artifact encryption and loopback S3-compatible storage.
PROOFSTACK_ARTIFACT_STORAGE_MODE=s3_local_keyring
PROOFSTACK_ARTIFACT_ACTIVE_KEY_ID=key_local_durable_replay
PROOFSTACK_ARTIFACT_KEYS='{"key_local_durable_replay":"KSkpKSkpKSkpKSkpKSkpKSkpKSkpKSkpKSkpKSkpKSk"}'
PROOFSTACK_ARTIFACT_S3_BUCKET=proofstack-local-durable-replay
PROOFSTACK_ARTIFACT_S3_ENDPOINT=http://127.0.0.1:8333
PROOFSTACK_ARTIFACT_S3_FORCE_PATH_STYLE=true
PROOFSTACK_ARTIFACT_S3_REGION=us-east-1

# SeaweedFS harness credentials. They are intentionally fixed and local-only.
AWS_ACCESS_KEY_ID=proofstack-local
AWS_SECRET_ACCESS_KEY=proofstack-local-secret
