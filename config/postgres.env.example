# Local-only durable development profile. Copy this file to .env; never reuse these credentials.
PROOFSTACK_ENV=development
PROOFSTACK_AUTH_MODE=development
PROOFSTACK_HOST=127.0.0.1
PROOFSTACK_PORT=4318
PROOFSTACK_LOG_LEVEL=info

# API runtime storage. This intentionally uses the least-privilege API role.
PROOFSTACK_POSTGRES_PORT=5432
PROOFSTACK_STORAGE_MODE=postgres
PROOFSTACK_DATABASE_URL=postgresql://proofstack_api:proofstack-local-api@127.0.0.1:5432/proofstack
PROOFSTACK_IDENTITY_DATABASE_URL=postgresql://proofstack_identity:proofstack-local-identity@127.0.0.1:5432/proofstack
PROOFSTACK_ARTIFACT_DATABASE_URL=postgresql://proofstack_artifact_maintenance:proofstack-local-artifact@127.0.0.1:5432/proofstack

# Database administration. Only migration and provisioning commands use this URL.
PROOFSTACK_MIGRATION_DATABASE_URL=postgresql://postgres:proofstack-local-admin@127.0.0.1:5432/proofstack
PROOFSTACK_API_DATABASE_PASSWORD=proofstack-local-api
PROOFSTACK_ARTIFACT_DATABASE_PASSWORD=proofstack-local-artifact
PROOFSTACK_IDENTITY_DATABASE_PASSWORD=proofstack-local-identity
PROOFSTACK_PUBLISHER_DATABASE_PASSWORD=proofstack-local-publisher
PROOFSTACK_CONSUMER_DATABASE_PASSWORD=proofstack-local-consumer

# Explicit workload-key bootstrap inputs. Uncomment and customize only while running the command.
# PROOFSTACK_IDENTITY_TENANT_ID=ten_local
# PROOFSTACK_BOOTSTRAP_ACTOR_PRINCIPAL_ID=usr_local_operator
# PROOFSTACK_BOOTSTRAP_KEY_NAME=local-agent
# PROOFSTACK_BOOTSTRAP_KEY_CAPABILITIES=evidence:ingest,evidence:read
# PROOFSTACK_BOOTSTRAP_KEY_RESOURCE_SCOPE='{"mode":"tenant"}'

# Operator console and SDK example.
PROOFSTACK_API_URL=http://127.0.0.1:4318
PROOFSTACK_PROJECT_ID=prj_local
PROOFSTACK_ENVIRONMENT_ID=env_local
# PROOFSTACK_API_KEY is intentionally absent. Store a newly issued value only in untracked config.

# OIDC and combined modes additionally require the PROOFSTACK_OIDC_* values documented in
# docs/development/local-development.md. Provider credentials and transaction keys stay untracked.
