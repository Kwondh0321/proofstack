# Local-only durable development profile. Copy this file to .env; never reuse these credentials.
PROOFSTACK_ENV=development
PROOFSTACK_AUTH_MODE=development
PROOFSTACK_HOST=127.0.0.1
PROOFSTACK_PORT=4318
PROOFSTACK_LOG_LEVEL=info

# API runtime storage. This intentionally uses the least-privilege API role.
PROOFSTACK_STORAGE_MODE=postgres
PROOFSTACK_DATABASE_URL=postgresql://proofstack_api:proofstack-local-api@127.0.0.1:5432/proofstack

# Database administration. Only migration and provisioning commands use this URL.
PROOFSTACK_MIGRATION_DATABASE_URL=postgresql://postgres:proofstack-local-admin@127.0.0.1:5432/proofstack
PROOFSTACK_API_DATABASE_PASSWORD=proofstack-local-api
PROOFSTACK_PUBLISHER_DATABASE_PASSWORD=proofstack-local-publisher
PROOFSTACK_CONSUMER_DATABASE_PASSWORD=proofstack-local-consumer

# Operator console and SDK example.
PROOFSTACK_API_URL=http://127.0.0.1:4318
PROOFSTACK_PROJECT_ID=prj_local
PROOFSTACK_ENVIRONMENT_ID=env_local
