# Local-only additive profile for the evaluation control-flow example. Source after
# config/postgres.env.example; never deploy these example credentials.
PROOFSTACK_EVALUATION_WORKER_DATABASE_URL=postgresql://proofstack_evaluation_worker:proofstack-local-evaluation-worker@127.0.0.1:5432/proofstack

# Reuse a lowercase namespace to prove idempotency, or choose a new 1-20 character value to retain
# a separate immutable example graph.
PROOFSTACK_EVALUATION_EXAMPLE_NAMESPACE=reference
