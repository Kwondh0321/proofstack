# In-memory local profile. For durable storage, copy config/postgres.env.example instead.
# These values are safe only for local development.
PROOFSTACK_ENV=development
PROOFSTACK_AUTH_MODE=development
PROOFSTACK_HOST=127.0.0.1
PROOFSTACK_PORT=4318
PROOFSTACK_LOG_LEVEL=info

# Operator console and SDK example.
PROOFSTACK_API_URL=http://127.0.0.1:4318
PROOFSTACK_PROJECT_ID=prj_local
PROOFSTACK_ENVIRONMENT_ID=env_local

# Set only when the web console is served from a different local origin.
# PROOFSTACK_CORS_ORIGIN=http://127.0.0.1:3000

# OIDC and combined modes require durable identity storage, an external HTTPS endpoint, an exact
# provider configuration, and an untracked 32-byte transaction secret. See the local development
# guide; no provider credentials or reusable secret are committed here.
