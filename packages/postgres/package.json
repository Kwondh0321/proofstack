{
  "name": "@proofstack/postgres",
  "version": "0.0.0",
  "private": true,
  "description": "PostgreSQL persistence adapter for ProofStack",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "proofstack-db": "./dist/cli.js"
  },
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf coverage dist",
    "db:migrate": "pnpm build && node dist/cli.js migrate",
    "db:provision": "pnpm build && node dist/cli.js provision",
    "db:status": "pnpm build && node dist/cli.js status",
    "lint": "biome lint src",
    "test": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@proofstack/contracts": "workspace:*",
    "@proofstack/core": "workspace:*",
    "pg": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
