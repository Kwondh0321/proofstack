{
  "name": "@proofstack/replay",
  "version": "0.0.0",
  "private": true,
  "description": "Canonical and fail-closed bounded replay primitives for ProofStack",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vectors/recorded-boundary-replay-v1.json": "./vectors/recorded-boundary-replay-v1.json",
    "./vectors/replay-definition-v1.json": "./vectors/replay-definition-v1.json"
  },
  "files": [
    "dist",
    "vectors"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf coverage dist",
    "lint": "biome lint src",
    "test": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "vectors:generate": "pnpm build && node scripts/generate-replay-definition-vectors.mjs && biome format --write vectors/replay-definition-v1.json"
  },
  "dependencies": {
    "@proofstack/contracts": "workspace:*",
    "@proofstack/datasets": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
