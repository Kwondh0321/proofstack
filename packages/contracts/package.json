{
  "name": "@proofstack/contracts",
  "version": "0.0.0",
  "private": true,
  "description": "Canonical public and internal contracts for ProofStack",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./evidence": {
      "types": "./dist/evidence.d.ts",
      "import": "./dist/evidence.js"
    },
    "./artifact": {
      "types": "./dist/artifact.d.ts",
      "import": "./dist/artifact.js"
    },
    "./dataset": {
      "types": "./dist/dataset.d.ts",
      "import": "./dist/dataset.js"
    },
    "./interaction": {
      "types": "./dist/interaction.d.ts",
      "import": "./dist/interaction.js"
    },
    "./interaction-export": {
      "types": "./dist/interaction-export.d.ts",
      "import": "./dist/interaction-export.js"
    },
    "./openapi": {
      "types": "./dist/openapi.d.ts",
      "import": "./dist/openapi.js"
    },
    "./recovery": {
      "types": "./dist/recovery.d.ts",
      "import": "./dist/recovery.js"
    },
    "./replay-plan": {
      "types": "./dist/replay-plan.d.ts",
      "import": "./dist/replay-plan.js"
    },
    "./replay-job": {
      "types": "./dist/replay-job.d.ts",
      "import": "./dist/replay-job.js"
    },
    "./replay-accounting": {
      "types": "./dist/replay-accounting.d.ts",
      "import": "./dist/replay-accounting.js"
    },
    "./replay-worker-protocol": {
      "types": "./dist/replay-worker-protocol.d.ts",
      "import": "./dist/replay-worker-protocol.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf coverage dist",
    "lint": "biome lint src",
    "test": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
