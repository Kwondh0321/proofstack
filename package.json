{
  "name": "proofstack",
  "version": "0.0.0",
  "private": true,
  "description": "Open-source Agent Reliability Engineering platform",
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "boundaries": "node scripts/check-boundaries.mjs",
    "artifacts:maintenance": "pnpm --filter @proofstack/artifact-maintenance cli",
    "check": "pnpm format:check && pnpm boundaries && pnpm docs:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "clean": "turbo run clean && rm -rf .turbo coverage",
    "dev": "turbo run dev",
    "dev:api": "pnpm --filter @proofstack/api dev",
    "dev:db:down": "docker compose down",
    "dev:db:up": "docker compose up --detach --wait postgres",
    "dev:object-storage:stop": "docker compose --profile object-storage stop seaweedfs",
    "dev:object-storage:up": "docker compose --profile object-storage up --detach --wait seaweedfs",
    "dev:web": "pnpm --filter @proofstack/web dev",
    "db:identity:bootstrap": "pnpm --filter @proofstack/postgres db:identity:bootstrap",
    "db:identity:status": "pnpm --filter @proofstack/postgres db:identity:status",
    "db:migrate": "pnpm --filter @proofstack/postgres db:migrate",
    "db:oidc:create": "pnpm --filter @proofstack/postgres db:oidc:create",
    "db:oidc:disable": "pnpm --filter @proofstack/postgres db:oidc:disable",
    "db:oidc:update": "pnpm --filter @proofstack/postgres db:oidc:update",
    "db:provision": "pnpm --filter @proofstack/postgres db:provision",
    "db:status": "pnpm --filter @proofstack/postgres db:status",
    "docs:check": "node scripts/check-doc-links.mjs",
    "example:basic-agent": "pnpm build && pnpm --filter @proofstack/example-basic-agent start",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint . && turbo run lint",
    "test": "turbo run test",
    "test:integration:postgres": "turbo run test:integration --concurrency=1 --filter=@proofstack/postgres --filter=@proofstack/api",
    "test:integration:s3": "turbo run test:integration --concurrency=1 --filter=@proofstack/s3",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "turbo": "2.10.12",
    "typescript": "6.0.3"
  }
}
