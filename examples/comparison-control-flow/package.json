{
  "name": "@proofstack/example-comparison-control-flow",
  "version": "0.0.0",
  "private": true,
  "description": "Runnable exact baseline-versus-candidate comparison experiment",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    "./adversarial-scenario": {
      "types": "./dist/adversarial-scenario.d.ts",
      "default": "./dist/adversarial-scenario.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "api": "node dist/api-server.js",
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf coverage dist",
    "lab": "node dist/server.js",
    "lint": "biome lint src",
    "start": "node dist/run.js",
    "test": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@proofstack/api": "workspace:*",
    "@proofstack/contracts": "workspace:*",
    "@proofstack/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
