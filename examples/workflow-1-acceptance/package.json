{
  "name": "@proofstack/example-workflow-1-acceptance",
  "version": "0.0.0",
  "private": true,
  "description": "Retained Workflow 1 failure-to-comparison acceptance flow",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    "./comparison-definition": {
      "types": "./dist/comparison-definition.d.ts",
      "default": "./dist/comparison-definition.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
