{
  "name": "@proofstack/example-workflow-1-acceptance",
  "version": "0.0.0",
  "private": true,
  "description": "Retained Workflow 1 failure-to-comparison acceptance flow",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    "./comparison-definition": {
      "types": "./dist/comparison-definition.d.ts",
      "default": "./dist/comparison-definition.js"
    },
    "./workflow": {
      "types": "./dist/workflow.d.ts",
      "default": "./dist/workflow.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf coverage dist",
    "lint": "biome lint src",
    "test": "vitest run --coverage",
    "test:integration": "pnpm build && vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@proofstack/contracts": "workspace:*",
    "@proofstack/example-durable-replay": "workspace:*",
    "@proofstack/example-evaluation-control-flow": "workspace:*",
    "@proofstack/example-model-assurance-control-flow": "workspace:*",
    "@proofstack/sdk": "workspace:*"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "catalog:",
    "@proofstack/api": "workspace:*",
    "@proofstack/core": "workspace:*",
    "@proofstack/evaluation-worker": "workspace:*",
    "@proofstack/example-workflow-2-release-candidate": "workspace:*",
    "@proofstack/example-workflow-2-release-policy": "workspace:*",
    "@proofstack/model-evaluation-worker": "workspace:*",
    "@proofstack/postgres": "workspace:*",
    "@proofstack/s3": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
