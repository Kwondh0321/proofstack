{
  "name": "@proofstack/example-evaluation-control-flow",
  "version": "0.0.0",
  "private": true,
  "description": "Service-backed contestable evaluation reference flow",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf coverage dist",
    "lint": "biome lint src",
    "start": "node dist/run.js",
    "test": "vitest run --coverage",
    "test:integration": "pnpm build && vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@proofstack/contracts": "workspace:*",
    "@proofstack/core": "workspace:*",
    "@proofstack/evaluation-worker": "workspace:*",
    "@proofstack/sdk": "workspace:*"
  },
  "devDependencies": {
    "@proofstack/api": "workspace:*",
    "@proofstack/postgres": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
